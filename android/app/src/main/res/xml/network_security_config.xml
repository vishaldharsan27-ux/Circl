<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed only to the laptop backend reached over USB via
     `adb reverse tcp:5000 tcp:5000` (BACKEND_ORIGIN=http://localhost:5000).
     Everything else, e.g. an ngrok/hosted backend, must use https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
